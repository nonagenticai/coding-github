# ==============================================================================
# coding-github Service Configuration
# ==============================================================================
# All env vars use the CODING_GITHUB_ prefix (from settings.py env_prefix)
# ==============================================================================

# --- Service ---
# CODING_GITHUB_SERVICE_NAME=coding-github
# CODING_GITHUB_DEBUG=false
#
# CODING_GITHUB_ENVIRONMENT gates every environment-dependent decision in this
# service: the SCHEMATHESIS_TESTING token bypass and the github_bypass_validation
# feature flag. It defaults to "production", so leaving it unset is safe — but
# setting the UNPREFIXED "ENVIRONMENT" alone does NOT reach it (that name belongs
# to coding_client's AuthMiddleware). In dev, set both.
# CODING_GITHUB_ENVIRONMENT=production

# --- Database ---
# CODING_GITHUB_DATABASE_URL=postgresql+psycopg://user:pass@postgres:5432/coding_github

# --- GitHub Credentials ---
# Personal access token or bot token for GitHub API calls
# CODING_GITHUB_GITHUB_TOKEN=ghp_your-token-here
# GitHub App credentials (alternative to PAT)
# CODING_GITHUB_GITHUB_APP_ID=12345
# CODING_GITHUB_GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# Webhook secret for validating GitHub webhook payloads
# CODING_GITHUB_GITHUB_WEBHOOK_SECRET=your-webhook-secret

# --- System GitHub (dual-token architecture) ---
# Separate token for system-level operations (e.g. org-wide scanning)
# CODING_GITHUB_SYSTEM_GITHUB_TOKEN=ghp_system-token-here
# CODING_GITHUB_SYSTEM_GITHUB_OWNER=nonagenticai

# --- Inter-Service Communication ---
# CODING_GITHUB_CODING_CONTAINERS_URL=http://coding-containers:8691

# --- Internal service-to-service secrets (one per caller) ---
# Guard /api/internal/* (scoped clone-token vending). Callers send their own
# secret as the X-Internal-Token header; the matched caller name is logged.
# No caller configured ⇒ endpoint is disabled (fail-closed: every request 403s).
#
# Authenticates caller "coding-containers" — must match the value it holds.
# CODING_GITHUB_INTERNAL_SERVICE_TOKEN=<random-32-byte-hex>
#
# Every OTHER caller gets its OWN secret here — never reuse another service's.
# JSON object {"<caller>": "<token>"}. Validated at startup: invalid JSON,
# non-string/empty tokens, two callers sharing a token, reuse of the token
# above, or a "coding-containers" entry while the token above is set all
# crash boot (errors name the caller key, never the token).
# CODING_GITHUB_INTERNAL_CALLER_TOKENS={"fr": "<random-32-byte-hex>"}

# --- Secrets API ---
# CODING_GITHUB_SECRETS_API_URL=https://secrets-api:8543
# CODING_GITHUB_CA_CERT_PATH=/certs/ca-cert.pem

# --- Feature Flags (optional, loaded via CODING_GITHUB_FEATURE_ prefix) ---
# CODING_GITHUB_FEATURE_WEBHOOKS_ENABLED=true
# CODING_GITHUB_FEATURE_PR_VALIDATION=true
